#!/usr/bin/env bash
# PYTHON_ARGCOMPLETE_OK
# Convenience launcher for the rag CLI without a manual install step.
# Ensures a venv with the required dependencies exists, then runs the CLI
# against the in-repo source.
#
# Usage: ./rag-cli -v extract email count=1
set -euo pipefail

# Absolute path to this script's directory (the repo root). Resolve any symlink
# chain first, so invoking via a symlink (e.g. ~/bin/rag -> /repo/rag-cli) uses the
# real script location for the venv + PYTHONPATH, not the symlink's directory.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    # A relative link target is relative to the directory holding the link.
    [[ $SOURCE == /* ]] || SOURCE="$LINK_DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
VENV="$DIR/.venv"
PY="$VENV/bin/python"

# Create the venv on first use.
if [ ! -x "$PY" ]; then
    python3 -m venv "$VENV"
fi

# Dependencies installed into the venv on first use. secretstorage + jeepney give
# the keyring the pure-python D-Bus SecretService backend (fixes the
# "libsecret required" error); pyyaml + keyring are the core deps.
# A sentinel marks completion so normal runs skip the check entirely. We install
# explicitly into the venv rather than probing imports, because a venv created
# with --system-site-packages can satisfy imports from system packages while its
# own site remains empty.
_DEPS=(pyyaml keyring secretstorage jeepney flask argcomplete markdownify mammoth openpyxl pypdf qdrant-client zstandard python-magic py7zr rarfile)
# The sentinel is keyed BOTH by Python version and by the dependency list:
# - Python version, because a shared .venv used from interpreters of different
#   versions has separate site-packages (lib/pythonX.Y/…); each version must
#   install its own packages.
# - dependency list, so adding a dep reinstalls (a bare "file exists" check would
#   silently miss newly-added dependencies).
_PYVER="$("$PY" -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
_SENTINEL="$VENV/.rag-deps-installed-$_PYVER"
_WANT="${_DEPS[*]}"
if [ "$(cat "$_SENTINEL" 2>/dev/null)" != "$_WANT" ]; then
    echo "rag-cli: installing dependencies into $VENV ..." >&2
    if command -v uv >/dev/null 2>&1; then
        # uv-managed venv (no pip inside): install with uv against this venv.
        uv pip install --python "$PY" -q "${_DEPS[@]}"
    else
        # Standard venv: bootstrap pip if needed, then install.
        "$PY" -m ensurepip --upgrade >/dev/null 2>&1 || true
        "$PY" -m pip install -q --upgrade pip
        "$PY" -m pip install -q "${_DEPS[@]}"
    fi
    printf '%s' "$_WANT" > "$_SENTINEL"
fi

# Force the pure-python SecretService keyring backend (provided by secretstorage,
# installed above). This overrides any local keyring config that selects the
# libsecret backend, which needs PyGObject/gi that we don't install. Both backends
# talk to the same D-Bus secret service (gnome-keyring / KWallet), so stored
# passwords are interchangeable.
export PYTHON_KEYRING_BACKEND="keyring.backends.SecretService.Keyring"

# Point the CLI at the repo's config.yaml as a fallback, so `rag` finds it when
# invoked (via a symlink) from a working directory that has no ./config.yaml. An
# explicit --config or a ./config.yaml in the cwd still takes precedence.
export RAG_CONFIG="$DIR/config.yaml"

# Put the repo on sys.path so `rag` imports, and use the venv interpreter.
exec env PYTHONPATH="$DIR" "$PY" -m rag.cli "$@"
