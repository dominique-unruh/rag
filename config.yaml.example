# rag configuration. Copy to config.yaml and edit.
# Everything except secrets lives here; secrets come from the OS keyring or a
# file (see the notes on each password below).

storage:
  # Directory holding the metadata DB, blobs and per-plugin state. Relative paths
  # are resolved against this config file's location.
  dir: ./storage

# One subtree per extractor, keyed by its source_type (== its subdirectory name
# under rag/extract/plugins/). An extractor only sees its own subtree.
extractors:

  email:
    # A list of IMAP accounts. Each message becomes a document with
    # doc_id = "<account-id>:<message-id>".
    accounts:
      - account-id: main            # short, stable; used in doc-ids
        description: Personal inbox  # human-readable only
        host: imap.example.org
        username: me@example.org
        # port: 993                  # optional; defaults to 993 (SSL) / 143 (plain)
        # ssl: true                  # optional; defaults to true
        # auth: login                # optional; 'login' (default) or 'plain'
        #                            # (SASL PLAIN) for servers that reject LOGIN
        # folders: [INBOX]           # optional; default: all folders on the server
        # exclude_folders: [Spam]    # optional; folders to skip (applied after the above)
        # Password resolution order (never put it here):
        #   1. desktop keyring (service "rag", key = "imap:<host>:<username>")
        #   2. interactive prompt (cached to the keyring for next time)

  documents:
    # A list of on-disk folders. Every regular file under a folder becomes a
    # document with doc_id = "<folder-id>:<relative-path>". Recurses into
    # subdirectories; symlinks and hidden files/dirs are skipped.
    #
    # A file may carry a "<file>.metadata.json" sidecar (as produced by the RWTH
    # intranet scraper); its JSON is folded into the document's metadata and its
    # "content_type" fixes the mime-type.
    #
    # Mime detection uses libmagic (content sniffing) — install the system
    # library (e.g. `apt install libmagic1`); the Python binding python-magic is
    # a declared dependency.
    folders:
      - folder-id: notes            # short, stable; used in doc-ids
        description: Obsidian vault  # human-readable only
        path: ~/notes               # ~ is expanded
      - folder-id: rwth-docs
        description: RWTH intranet document mirror (with sidecars)
        path: ~/r/ai-automation/rwth-intranet-scrape/files
    # max_file_size: 104857600      # optional; per-file byte cap (default 100 MiB).
    #                               # Files above it are skipped with an error.
    # exclude:                      # optional; extra basename globs, added to the
    #   - "*.bak"                   # built-in defaults (.*, *~, *.swp, *.tmp, ...)

# Embedding (module 3). Each model has its own vector index; run one pass per
# model: `rag embed --model <id>`.
embedding:
  chunk_size: 1024        # characters per chunk
  chunk_overlap: 128      # overlap between consecutive chunks
  models:
    # Native Ollama backend.
    - id: qwen3-8b
      type: dense
      backend: ollama
      host: http://localhost:11434
      model: qwen3-embedding:8b
      dim: 4096
      # query_instruction: "Instruct: retrieve relevant documents\nQuery: "
      # Per-request batching / timeout (dense backends). Small batches keep each
      # request under `timeout` on slow CPU embedders; raise batch_size on GPU.
      # batch_size: 16     # max chunks per request (default 16)
      # timeout: 300       # seconds per request (default 300)
    # Sparse: local BM25 for exact-term matches (names, IDs, order numbers).
    # No model/service — tokenised locally; Qdrant applies IDF at query time.
    - id: bm25
      type: sparse
      backend: bm25

    # OpenAI-compatible dense backend (also covers Ollama's /v1, LM Studio, vLLM).
    # - id: nomic
    #   type: dense
    #   backend: openai
    #   api_base: http://localhost:11434/v1
    #   model: nomic-embed-text
    #   dim: 768
    #   # api_key_name: my-embed-key   # optional; resolved via the keyring
